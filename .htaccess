# Solo /public (la SPA) y /api (los endpoints) se sirven por HTTP.
# Sin esto, cualquiera podía descargar sql/schema.sql (con los hashes de
# las contraseñas) o el historial de .git desde el navegador.

RewriteEngine On

# La raíz del proyecto lleva directo a la SPA. Se arma desde la URL pedida
# (REQUEST_URI) porque una ruta relativa acá Apache la completa con la del disco.
RewriteRule ^$ %{REQUEST_URI}public/ [R=302,L]

# 403 para carpetas internas y archivos de ayuda de la API (api/_*.php).
RewriteRule ^(config|models|sql|\.git)(/|$) - [F,L]
RewriteRule ^api/_ - [F,L]

# No listar el contenido de las carpetas.
Options -Indexes

# Cabeceras de seguridad (OWASP A05). La Content Security Policy solo deja
# ejecutar scripts y estilos propios del sitio: aunque se colara un <script>
# en algún dato, el navegador no lo ejecutaría. Las imágenes pueden venir de
# cualquier https:// porque el admin carga URLs externas (ej. Unsplash).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' https:; connect-src 'self'; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# Que el navegador siempre consulte si hay una versión nueva del HTML, el CSS
# y el JS (si no cambió, Apache responde 304 y usa la copia guardada). Sin
# esto, Chrome podía seguir usando un app.js viejo después de actualizar.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
